{
  "name": "truck",
  "version": "1.0.0",
  "description": "",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"npm run dev --prefix client\"",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm --prefix client install && npm --prefix client run build",
    "build:all": "npm install && npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "app:sync": "npm run build --prefix client && npm run --prefix client cap:sync",
    "app:open": "npm run --prefix client cap:open",
    "app:build": "cmd /c \"cd client\\android && gradlew.bat assembleDebug\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0"
  }
}
